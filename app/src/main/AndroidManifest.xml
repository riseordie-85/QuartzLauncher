<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Privacy: Quartz never sends anything about you anywhere. The one thing that goes out is a weather request,
         and only if you put a weather widget on your home screen: Open-Meteo gets a rough location (about 1 km). -->

    <!-- Weather for weather widgets (Open-Meteo), and finding a city by name. Nothing else uses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only if a weather widget uses this phone's location (Android asks first). Coarse only; a city works instead. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Lets "swipe down" open the notification shade -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Only used if you turn on contacts in search (off by default; Android asks first). Read on the phone, never sent anywhere. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <!-- Lets the launcher see every app that has a home-screen icon -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Lets Quartz find icon packs you've installed (the common launcher icon pack formats) -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.QuartzLauncher">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|fontScale">

            <!-- Makes Quartz choosable as the home app -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- Also listed in the stock app drawer, so it can be opened before it's the default -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Settings and setup: a frosted sheet over the wallpaper -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.QuartzLauncher.Settings"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />

        <!-- Quartz Lock: only used to lock the screen from a gesture -->
        <service
            android:name=".LockService"
            android:exported="false"
            android:label="@string/lock_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- Badges: counts notifications per app (never reads them). Only runs if you turn on notification access. -->
        <service
            android:name=".BadgeService"
            android:exported="true"
            android:label="@string/badge_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The Quartz wallpaper: gradients, colors, your images and patterns, fold-aware -->
        <service
            android:name=".wallpaper.QuartzWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" />
        </service>
    </application>
</manifest>
